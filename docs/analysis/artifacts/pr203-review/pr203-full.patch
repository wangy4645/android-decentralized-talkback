+        val snapshot = star()
+        val before = snapshot.actualMediaEdges.toSet()
+        val view = ConferencePerEdgeMediaFactContract.viewOf(
+            input("M03", listOf(fact(usable = false)), iceToAnchor = true, snapshot = snapshot),
+            "M04"
