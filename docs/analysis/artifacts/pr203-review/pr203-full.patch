+            channelId = "LATE-PEER-MULTI-A",
+            sessionId = "dup-session-a",
+            initiatorModuleId = "M01",
+            connectedPeerModuleIds = listOf("M02")
+        )
+        nodeM01.runtime.testSeedDuplicateGroupSession(
+            channelId = "LATE-PEER-MULTI-B",
+            sessionId = "dup-session-b",
+            initiatorModuleId = "M01",
+            connectedPeerModuleIds = listOf("M02")
+        )
