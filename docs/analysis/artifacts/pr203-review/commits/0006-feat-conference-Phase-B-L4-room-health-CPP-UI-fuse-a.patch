+
+    @Test
+    fun m5_rosterAddMember_authorizedEdgeTransaction_bumpsGeneration() {
+        val base = anchorSnapshot(meshGeneration = 5L)
+        val result = ConferenceMediaEdgeAdmissionContract.admitFromRosterChange(
