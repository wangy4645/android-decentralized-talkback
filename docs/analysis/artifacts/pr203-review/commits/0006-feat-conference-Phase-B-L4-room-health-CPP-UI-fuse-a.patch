+
+    @Test
+    fun t3_meshToAnchor_replacesEmptyWithStar_notMerge() {
+        val mesh = ConferenceTopologyModeTransitionContract.composeMeshSnapshot(
+            "c1", "M01", roster3, rosterEpoch = 1L, meshGeneration = 0L
+        )
