<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tb_bg">

    <LinearLayout
        android:id="@+id/panelActiveCall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp">

            <ImageButton
                android:id="@+id/btnCallBack"
                style="@style/TalkbackToolbarIconButton"
                android:layout_gravity="center_vertical|start"
                android:contentDescription="@string/cd_settings_back"
                android:src="@drawable/ic_settings_back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHeaderName"
                    style="@style/SettingsRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/txtHeaderTeam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:textColor="@color/tb_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnHeaderMore"
                style="@style/TalkbackToolbarIconButton"
                android:layout_gravity="center_vertical|end"
                android:contentDescription="@string/call_control_more"
                android:src="@drawable/ic_toolbar_more_vert" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/chipConnectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_call_connected_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_call_dot" />

                    <TextView
                        android:id="@+id/txtConnectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:text="@string/call_status_connected_pill"
                        android:textColor="@color/tb_primary"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/call_identity_area_height"
                android:layout_marginTop="@dimen/call_identity_block_margin_top"
                android:layout_marginBottom="@dimen/call_identity_to_banner_gap"
                android:clipChildren="false"
                android:clipToPadding="false">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:layout_width="@dimen/call_radar_ring_6"
                        android:layout_height="@dimen/call_radar_ring_6"
                        android:layout_gravity="center"
                        android:alpha="0.10"
                        android:background="@drawable/bg_ptt_radar_ring" />

                    <View
                        android:layout_width="@dimen/call_radar_ring_5"
                        android:layout_height="@dimen/call_radar_ring_5"
                        android:layout_gravity="center"
                        android:alpha="0.16"
                        android:background="@drawable/bg_ptt_radar_ring" />

                    <View
                        android:layout_width="@dimen/call_radar_ring_4"
                        android:layout_height="@dimen/call_radar_ring_4"
                        android:layout_gravity="center"
                        android:alpha="0.24"
                        android:background="@drawable/bg_ptt_radar_ring" />

                    <View
                        android:layout_width="@dimen/call_radar_ring_3"
                        android:layout_height="@dimen/call_radar_ring_3"
                        android:layout_gravity="center"
                        android:alpha="0.34"
                        android:background="@drawable/bg_ptt_radar_ring" />

                    <View
                        android:layout_width="@dimen/call_radar_ring_2"
                        android:layout_height="@dimen/call_radar_ring_2"
                        android:layout_gravity="center"
                        android:alpha="0.46"
                        android:background="@drawable/bg_ptt_radar_ring" />

                    <View
                        android:layout_width="@dimen/call_radar_ring_1"
                        android:layout_height="@dimen/call_radar_ring_1"
                        android:layout_gravity="center"
                        android:alpha="0.58"
                        android:background="@drawable/bg_ptt_radar_ring" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/badgeIdentity"
                    android:layout_width="@dimen/call_badge_size"
                    android:layout_height="@dimen/call_badge_size"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ptt_button">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtBadgeModule"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:textColor="@color/tb_text_primary"
                            android:textSize="26sp" />

                        <TextView
                            android:id="@+id/txtBadgeEndpoint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/tb_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/callBottomCluster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/bannerCallStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/call_banner_margin_top"
                    android:background="@drawable/bg_call_status_banner"
                    android:gravity="center"
                    android:minHeight="@dimen/call_banner_min_height"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:visibility="invisible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/call_banner_dots"
                        android:textColor="@color/tb_primary"
                        android:textSize="10sp" />

                    <ImageView
                        android:id="@+id/imgStatusIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mic_ptt"
                        android:tint="@color/tb_primary" />

                    <TextView
                        android:id="@+id/txtCallStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:textColor="@color/tb_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:includeFontPadding="false"
                        android:text="@string/call_banner_dots"
                        android:textColor="@color/tb_primary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowAudioMeter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/call_meter_margin_horizontal"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgMeterMic"
                            android:layout_width="@dimen/call_level_meter_icon_size"
                            android:layout_height="@dimen/call_level_meter_icon_size"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_mic_ptt"
                            android:tint="@color/tb_primary" />

                        <com.talkback.appprod.ui.CallHorizontalVolumeMeterView
                            android:id="@+id/meterCallVolume"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/call_level_meter_height"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCallTimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/call_meter_timer_margin_top"
                    android:layout_marginBottom="@dimen/call_timer_margin_bottom"
                    android:fontFamily="monospace"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:textColor="@color/tb_text_primary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/rowInCallControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/call_controls_margin_bottom"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <include
                        android:id="@+id/btnMute"
                        layout="@layout/item_call_control_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/btnSpeaker"
                        layout="@layout/item_call_control_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/btnAudioRoute"
                        layout="@layout/item_call_control_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnEndCall"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/call_end_button_height"
                    android:layout_marginHorizontal="@dimen/call_end_button_margin_horizontal"
                    android:background="@drawable/bg_call_end_button"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/call_end_button_padding_h"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/call_end_icon_size"
                        android:layout_height="@dimen/call_end_icon_size"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_conversation_call"
                        android:tint="@color/tb_white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:text="@string/call_end"
                        android:textColor="@color/tb_white"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/call_bottom_safe_margin" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowIncomingActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                style="@style/CallIncomingDeclineButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/call_reject" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccept"
                style="@style/CallIncomingAcceptButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/call_accept" />
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/panelCallEnded"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_call_check" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/call_ended_title"
                android:textColor="@color/tb_text_primary"
                android:textSize="@dimen/call_ended_title_text_size"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/txtEndedDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:textColor="@color/tb_text_muted"
                android:textSize="@dimen/call_ended_duration_text_size"
                android:textStyle="normal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="@string/call_summary_title"
                    android:textColor="@color/tb_primary"
                    android:textSize="@dimen/call_ended_summary_title_text_size"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/txtSummaryBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/tb_text_secondary"
                    android:textSize="@dimen/call_ended_summary_body_text_size"
                    android:textStyle="normal" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToContacts"
                style="@style/CallEndedBackButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/call_back_to_contacts" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
